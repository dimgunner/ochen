# --- LLM proxy (OpenAI-compatible provider) -----------------------------
# Without these values the service falls back to local semantic matching.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_TIMEOUT=20
LLM_MAX_OBJECTS=3

# --- Django -------------------------------------------------------------
# Defaults are fine for local development; set real values when deploying.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
