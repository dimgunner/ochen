# --- LLM proxy (OpenAI-compatible provider) -----------------------------
# Without these values the service falls back to local semantic matching.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_TIMEOUT=20
LLM_MAX_OBJECTS=3

# --- Django -------------------------------------------------------------
# Defaults are fine for local development; set real values when deploying.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- API protection -----------------------------------------------------
MAX_INPUT_CHARS=1000
MAX_REQUEST_BYTES=65536
API_RATE_LIMIT=60
API_RATE_WINDOW=60
# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=0

# --- Runtime ------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
DJANGO_CACHE_DIR=/tmp/ochen-cache
